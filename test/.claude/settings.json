{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python.exe *)",
      "Bash(py *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pip *)",
      "Bash(conda *)",
      "Bash(pixi *)",
      "Bash(poetry *)",
      "Bash(marimo *)",
      "Bash(bash **/scripts/discover-servers.sh *)",
      "Bash(bash **/scripts/execute-code.sh *)",
      "Bash(bash scripts/discover-servers.sh *)",
      "Bash(bash scripts/execute-code.sh *)",
      "Bash(bash *discover-servers.sh)",
      "Bash(bash *execute-code.sh)",
      "Read"
    ],
    "deny": [
      "mcp__*",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "default"
  }
}
